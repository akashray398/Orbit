<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude personal database from unencrypted cloud backups for privacy -->
        <exclude domain="database" path="orbit_database.db" />
        <exclude domain="database" path="orbit_database.db-journal" />
        <exclude domain="database" path="orbit_database.db-shm" />
        <exclude domain="database" path="orbit_database.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="orbit_database.db" />
    </device-transfer>
</data-extraction-rules>
