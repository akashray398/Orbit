<?xml version="1.0" encoding="utf-8"?>
<!-- Single-Source Geometry: Center (54,54). Core R=16, Ring Rx=28, Ry=12 tilted -25 deg, Satellite at (72,40) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="orbit_glow">
        <path
            android:name="orbit_glow_outer"
            android:pathData="M 54,54 m -32,0 a 32,32 0 1,0 64,0 a 32,32 0 1,0 -64,0"
            android:fillColor="#1A22D3EE"/>
        <path
            android:name="orbit_glow_inner"
            android:pathData="M 54,54 m -22,0 a 22,22 0 1,0 44,0 a 22,22 0 1,0 -44,0"
            android:fillColor="#337C5CFF"/>
    </group>

    <group android:name="orbit_core">
        <path
            android:name="orbit_core_sphere"
            android:pathData="M 54,54 m -16,0 a 16,16 0 1,0 32,0 a 16,16 0 1,0 -32,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="38"
                    android:startY="38"
                    android:endX="70"
                    android:endY="70"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF7C5CFF" />
                    <item android:offset="1.0" android:color="#FF22D3EE" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <group android:name="orbit_ring">
        <path
            android:name="orbit_ring_path"
            android:pathData="M 28,60 C 22,46 40,34 62,38 C 84,42 90,56 76,68 C 62,80 34,74 28,60 Z"
            android:strokeWidth="3.5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="25"
                    android:startY="60"
                    android:endX="85"
                    android:endY="45"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF7C5CFF" />
                    <item android:offset="0.7" android:color="#FF22D3EE" />
                    <item android:offset="1.0" android:color="#2022D3EE" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <group android:name="orbit_satellite">
        <path
            android:name="orbit_satellite_dot"
            android:pathData="M 72,40 m -3.5,0 a 3.5,3.5 0 1,0 7,0 a 3.5,3.5 0 1,0 -7,0"
            android:fillColor="#FF22D3EE"/>
        <path
            android:name="orbit_satellite_core"
            android:pathData="M 72,40 m -1.5,0 a 1.5,1.5 0 1,0 3,0 a 1.5,1.5 0 1,0 -3,0"
